# 运行环境：development / test / production
APP_ENV=development

# 本地默认使用 SQLite；T003 再接入数据库引擎和迁移
DATABASE_URL=sqlite:///./data/job_agent.db

# LLM_PROVIDER=fake 时不需要填写密钥
LLM_PROVIDER=fake
LLM_MODEL=unset
LLM_API_KEY=

DATA_DIR=./data
SNAPSHOT_DIR=./data/snapshots
PLAYWRIGHT_AUTH_DIR=./data/playwright
BROWSER_HEADLESS=true
BROWSER_DRY_RUN=true
LOG_LEVEL=INFO
MAX_DAILY_SUBMISSIONS=10

