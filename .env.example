# 运行环境：development / test / production
APP_ENV=development

# 本地默认使用 SQLite；T003 再接入数据库引擎和迁移
DATABASE_URL=sqlite:///./data/job_agent.db

# 默认 Fake 完全离线；只有显式启用 openai_compatible 才会发起网络请求。
LLM_ENABLED=false
LLM_PROVIDER=fake
LLM_MODEL=unset
LLM_API_KEY=
LLM_BASE_URL=

DATA_DIR=./data
SNAPSHOT_DIR=./data/snapshots
PLAYWRIGHT_AUTH_DIR=./data/playwright
BROWSER_HEADLESS=true
BROWSER_DRY_RUN=true
LOG_LEVEL=INFO
MAX_DAILY_SUBMISSIONS=10

